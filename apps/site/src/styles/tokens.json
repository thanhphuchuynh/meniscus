{
  "$description": "Ray Plate design tokens (W3C design-token format). Two-colour textbook print: cool plate stock, blue-black ink, one vermilion spot ink for rays and active states, pale cyan only inside glass bodies. The dark theme is a lantern slide: the same plate, projected. Lantern values live in $extensions[\"meniscus.themes\"]. Edit this file, then run `pnpm --filter site tokens` to regenerate tokens.css.",
  "color": {
    "$type": "color",
    "stock": {
      "$value": "#eef2f4",
      "$description": "Plate stock: the page ground.",
      "$extensions": {
        "meniscus.themes": {
          "lantern": "#0b141d"
        }
      }
    },
    "stock-deep": {
      "$value": "#e2e8ec",
      "$description": "Recessed stock: wells and code grounds.",
      "$extensions": {
        "meniscus.themes": {
          "lantern": "#07101a"
        }
      }
    },
    "stock-raised": {
      "$value": "#f6f8f9",
      "$description": "Raised stock: the install line, hovered icon buttons.",
      "$extensions": {
        "meniscus.themes": {
          "lantern": "#111d28"
        }
      }
    },
    "ink": {
      "$value": "#0f1a24",
      "$description": "Text and engraved lines on any stock.",
      "$extensions": {
        "meniscus.themes": {
          "lantern": "#e6edf1"
        }
      }
    },
    "ink-soft": {
      "$value": "#364452",
      "$description": "Secondary text, captions, idle controls.",
      "$extensions": {
        "meniscus.themes": {
          "lantern": "#b3c0ca"
        }
      }
    },
    "ink-faint": {
      "$value": "#5a6773",
      "$description": "Small-caps labels, units, graduations.",
      "$extensions": {
        "meniscus.themes": {
          "lantern": "#8a99a6"
        }
      }
    },
    "spot": {
      "$value": "#ff4a1c",
      "$description": "Vermilion spot ink: rays, the sun, active and focused states only.",
      "$extensions": {
        "meniscus.themes": {
          "lantern": "#ff643a"
        }
      }
    },
    "spot-ink": {
      "$value": "#c2320e",
      "$description": "Text-safe spot for type and hover fills.",
      "$extensions": {
        "meniscus.themes": {
          "lantern": "#ff8660"
        }
      }
    },
    "glass-fill": {
      "$value": "#c4e4ec",
      "$description": "Glass cyan: glass bodies in diagrams, and selections.",
      "$extensions": {
        "meniscus.themes": {
          "lantern": "#173f4b"
        }
      }
    },
    "glass-edge": {
      "$value": "#7fb9c8",
      "$description": "The outline and hatch of glass bodies.",
      "$extensions": {
        "meniscus.themes": {
          "lantern": "#3f8ea3"
        }
      }
    },
    "rule": {
      "$value": "rgba(15, 26, 36, 0.86)",
      "$description": "Full rules: plate frames, table heads, control borders.",
      "$extensions": {
        "meniscus.themes": {
          "lantern": "rgba(230, 237, 241, 0.82)"
        }
      }
    },
    "rule-faint": {
      "$value": "rgba(15, 26, 36, 0.18)",
      "$description": "Faint rules: row dividers, stage borders.",
      "$extensions": {
        "meniscus.themes": {
          "lantern": "rgba(230, 237, 241, 0.16)"
        }
      }
    }
  },
  "glass": {
    "$type": "color",
    "glass-wash": {
      "$value": "rgba(255, 255, 255, 0.2)",
      "$description": "Tint of glass controls laid over a plate (specimens).",
      "$extensions": {
        "meniscus.themes": {
          "lantern": "rgba(12, 24, 34, 0.3)"
        }
      }
    },
    "glass-wash-clear": {
      "$value": "rgba(255, 255, 255, 0.16)",
      "$description": "Tint of large glass bodies over a plate, where the engraving should read through.",
      "$extensions": {
        "meniscus.themes": {
          "lantern": "rgba(12, 24, 34, 0.28)"
        }
      }
    },
    "glass-spot": {
      "$value": "rgba(255, 74, 28, 0.12)",
      "$description": "Tint of a selection indicator in a glass bar.",
      "$extensions": {
        "meniscus.themes": {
          "lantern": "rgba(255, 100, 58, 0.2)"
        }
      }
    },
    "glass-spot-strong": {
      "$value": "rgba(255, 74, 28, 0.14)",
      "$description": "Tint of the one active glass control in a group, such as Play.",
      "$extensions": {
        "meniscus.themes": {
          "lantern": "rgba(255, 100, 58, 0.24)"
        }
      }
    },
    "glass-bar": {
      "$value": "color-mix(in srgb, var(--stock) 62%, transparent)",
      "$description": "Tint of the masthead: stock, so the bar reads as part of the page."
    },
    "glass-lens": {
      "$value": "color-mix(in srgb, var(--glass-fill) 50%, transparent)",
      "$description": "Tint of the masthead's hover lens."
    },
    "glass-select": {
      "$value": "color-mix(in srgb, var(--glass-fill) 72%, transparent)",
      "$description": "Tint of the selection in segmented controls."
    }
  },
  "shadow": {
    "$type": "shadow",
    "shadow-lens": {
      "$value": "0 1px 2px rgba(15, 26, 36, 0.12), 0 4px 12px -4px rgba(15, 26, 36, 0.18)",
      "$description": "Under the masthead's hover lens."
    },
    "shadow-select": {
      "$value": "0 1px 2px rgba(15, 26, 36, 0.16)",
      "$description": "Under the selection in segmented controls."
    }
  },
  "font": {
    "$type": "fontFamily",
    "font-display": {
      "$value": [
        "Archivo Variable",
        "Archivo",
        "Helvetica Neue",
        "sans-serif"
      ],
      "$description": "Headings, controls, labels: Archivo, width axis up to 125%."
    },
    "font-text": {
      "$value": [
        "STIX Two Text Variable",
        "STIX Two Text",
        "Times New Roman",
        "serif"
      ],
      "$description": "Running text and captions."
    },
    "font-mono": {
      "$value": [
        "JetBrains Mono Variable",
        "JetBrains Mono",
        "ui-monospace",
        "SFMono-Regular",
        "monospace"
      ],
      "$description": "Code and figures."
    }
  },
  "font-size": {
    "$type": "dimension",
    "$description": "Four text steps, each about 1.25x the last.",
    "fs-label": {
      "$value": "0.75rem",
      "$description": "12px: small-caps labels, table heads, folios."
    },
    "fs-ui": {
      "$value": "0.9375rem",
      "$description": "15px: controls, captions, notes, code."
    },
    "fs-body": {
      "$value": "1.1875rem",
      "$description": "19px: running text."
    },
    "fs-lede": {
      "$value": "1.5rem",
      "$description": "24px: ledes."
    }
  },
  "space": {
    "$type": "dimension",
    "hair": {
      "$value": "1px",
      "$description": "Every rule and border."
    },
    "measure": {
      "$value": "66ch",
      "$description": "Longest line of running text."
    },
    "gutter": {
      "$value": "clamp(16px, 3.6vw, 44px)",
      "$description": "Side gutter of the page."
    },
    "plate-pad": {
      "$value": "clamp(16px, 3vw, 40px)",
      "$description": "Padding inside a plate frame."
    }
  },
  "motion": {
    "ease-out": {
      "$type": "cubicBezier",
      "$value": [
        0.16,
        1,
        0.3,
        1
      ],
      "$description": "The page's one easing curve. Glass moves on the library's springs instead."
    }
  },
  "focus": {
    "meniscus-focus-ring": {
      "$value": "2px solid var(--spot)",
      "$description": "The focus ring meniscus draws on a whole glass field or tick box: the page's spot ink."
    }
  }
}
